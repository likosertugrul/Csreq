# ---- Gerekli ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Turso (veritabanı) ----
# turso db show csreq --url  →  libsql://csreq-....turso.io
# turso db tokens create csreq
# Local test için boş bırakın — @libsql/client file:./csreq.db kullanır
TURSO_DATABASE_URL=libsql://csreq-....turso.io
TURSO_AUTH_TOKEN=eyJh...

# Session şifresi (güçlü rastgele bir string)
SESSION_SECRET=guclu-rastgele-bir-sifre-buraya

# Uygulamanın tam URL'i (local dev için otomatik localhost:3001)
APP_URL=http://localhost:3001

# ---- Google OAuth (opsiyonel) ----
# Google Cloud Console'dan: APIs & Services > Credentials > Create OAuth 2.0 Client ID
# Authorized redirect URI olarak ekle: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Lemon Squeezy (ödeme) ----
# Dashboard > Products > (ürün) > Share > Copy link
LEMON_MONTHLY_URL=https://xxx.lemonsqueezy.com/buy/...
LEMON_LIFETIME_URL=https://xxx.lemonsqueezy.com/buy/...
# Dashboard > Settings > Webhooks > Signing secret
LEMON_SIGNING_SECRET=

# ---- E-posta (opsiyonel) ----
# Ayarlanmazsa doğrulama linki terminale yazdırılır (geliştirme ortamı)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ornek@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx # Gmail: 2FA açıksa App Password kullan
SMTP_FROM=csreq <ornek@gmail.com>
